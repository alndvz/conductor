FROM fedora:latest

RUN dnf -y update && \
    dnf -y install \
      bash \
      bubblewrap \
      curl \
      findutils \
      gcc-c++ \
      git \
      make \
      nodejs \
      nodejs-devel \
      npm \
      procps-ng \
      shadow-utils \
      squid \
      which && \
    npm install -g opencode-ai bun && \
    dnf clean all

COPY dev-egress-allowlist.txt /etc/squid/egress-allowlist.txt
COPY dev-squid.conf /etc/squid/conductor-squid.conf

WORKDIR /workspace
